# Copy to .env and fill in what you want. Everything is optional; with no
# keys the app runs on demo flight data so you can try it out.

# --- Flight prices: mock | duffel | serpapi ---
# Leave unset to pick automatically: serpapi if SERPAPI_KEY is set, else duffel, else mock
# FLIGHT_PROVIDER=
# https://duffel.com -> Developers -> Access tokens
DUFFEL_ACCESS_TOKEN=
# https://serpapi.com (Google Flights results; free plan = 100 searches/month)
SERPAPI_KEY=

# --- Man City fixtures (https://www.football-data.org/client/register, free) ---
FOOTBALL_DATA_API_KEY=

# --- Phone alerts via the free ntfy app (https://ntfy.sh). Pick a hard-to-guess topic. ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Tracking ---
# Defaults to 24 with a SerpApi key (free plan = 100 searches/month), otherwise 12
# CHECK_INTERVAL_HOURS=24
# Max (outbound date x return date) pairs per trip. Each pair = 1 search per route.
MAX_DATE_COMBOS=12

# --- Connections into Manchester (United doesn't fly there) ---
# The Manchester route allows this many stops even if the trip's limit is lower
# MAN_MAX_STOPS=2
# United + one of these partners, changing planes at one of these hubs, counts as
# a United trip. Adds 1 search per date pair; set PARTNER_AIRLINES= (empty) to turn off.
# PARTNER_AIRLINES=LH,SN
# PARTNER_HUBS=BRU,FRA

# --- Ground legs (one-way, per person, GBP) ---
# Elizabeth line Heathrow -> Tottenham Court Road + Northern line to Euston
HEATHROW_TRANSFER_GBP=16
# Train Manchester Airport -> Piccadilly
MANCHESTER_AIRPORT_TRANSFER_GBP=5
# Landing at LHR -> earliest train you could catch at Euston (immigration + cross-London)
LHR_TO_EUSTON_MINUTES=150
# Train arriving Euston -> flight leaving LHR (cross-London + check-in)
EUSTON_TO_LHR_MINUTES=240
# Pick the cheapest train within this many minutes of the first one you can catch
TRAIN_WINDOW_MINUTES=180

# PORT=3000
# DB_PATH=./data/tracker.db
